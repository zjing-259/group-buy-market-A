<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>4.1.1</version><relativePath/></parent>
  <groupId>cn.bugstack</groupId><artifactId>ab-v2-client-compatibility</artifactId><version>1.0-SNAPSHOT</version>
  <properties>
    <java.version>17</java.version>
    <!-- Dubbo 3.2 uses the Netty 4.1 API; Boot 4's default 4.2 changes TLS engine behavior. -->
    <netty.version>4.1.118.Final</netty.version>
  </properties>
  <dependencies>
    <dependency><groupId>mysql</groupId><artifactId>mysql-connector-java</artifactId><version>8.0.22</version><scope>test</scope></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>cn.bugstack</groupId><artifactId>group-buy-market-contract</artifactId><version>1.0-SNAPSHOT</version></dependency>
    <!-- Use raw SDKs rather than introducing the A Boot 2 starter into B Boot 4. -->
    <dependency><groupId>org.apache.dubbo</groupId><artifactId>dubbo</artifactId><version>3.2.16</version></dependency>
    <dependency><groupId>org.apache.rocketmq</groupId><artifactId>rocketmq-client</artifactId><version>4.9.7</version></dependency>
    <dependency><groupId>org.apache.rocketmq</groupId><artifactId>rocketmq-acl</artifactId><version>4.9.7</version></dependency>
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><version>2.15.4</version></dependency>
  </dependencies>
</project>
