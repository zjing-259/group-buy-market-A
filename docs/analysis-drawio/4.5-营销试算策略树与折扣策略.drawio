<mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#b85450;fontColor=#b85450;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="nt2" target="ntm"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e8" value="均成功" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="ntm" target="nmk2"><mxGeometry relative="1" as="geometry"/></mxCell>
