  <diagram id="4.5-营销试算策略树与折扣策略" name="4.5-营销试算策略树与折扣策略">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="2600" math="0" shadow="0">
      <root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="nstart" value="&lt;b&gt;请求进入&lt;/b&gt;&lt;br&gt;indexMarketTrial(userId, goodsId, source, channel)&lt;br&gt;(Controller: query_group_buy_market_config)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890.0" y="30.0" width="220" height="48" as="geometry"/></mxCell>
<mxCell id="nroot" value="&lt;b&gt;RootNode · 参数校验&lt;/b&gt;&lt;br&gt;userId/goodsId/source/channel 非空，否则抛参错" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890.0" y="205.0" width="340" height="64" as="geometry"/></mxCell>
<mxCell id="nsw" value="&lt;b&gt;SwitchNode · 运营开关拦截&lt;/b&gt;&lt;br&gt;① repository.downgradeSwitch()?&lt;br&gt;   是 → 抛 E0003 活动降级&lt;br&gt;② repository.cutRange(userId)?&lt;br&gt;   |hash|%100 &lt;= cutRange 才放行&lt;br&gt;   否 → 抛 E0004 切量拦截" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890.0" y="380.0" width="340" height="64" as="geometry"/></mxCell>
<mxCell id="nswNo" value="&lt;b&gt;被开关挡下&lt;/b&gt;&lt;br&gt;E0003 降级 / E0004 切量，直接返回错误" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#a61b1b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1750.0" y="380.0" width="330" height="74" as="geometry"/></mxCell>
<mxCell id="nmk1" value="&lt;b&gt;MarketNode.multiThread · 并行预载数据&lt;/b&gt;&lt;br&gt;两个独立查询各自包成 Callable + FutureTask&lt;br&gt;丢进 Spring 共享线程池(核心20/最大50/队列5000)&lt;br&gt;后统一 futureTask.get(5, SECONDS) 限时取回" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890.0" y="555.0" width="340" height="64" as="geometry"/></mxCell>
<mxCell id="nt1" value="&lt;b&gt;任务① 查活动VO&lt;/b&gt;&lt;br&gt;QueryGroupBuyActivityDiscountVOThreadTask&lt;br&gt;source+channel+goodsId → SCSkuActivity&lt;br&gt;→ 命中活动 group_buy_activity&lt;br&gt;→ 折扣 group_buy_discount" style="rounded=1;whiteSpace=wrap;html=1;shape=cylinder3;boundedLbl=1;backgroundOutline=1;verticalAlign=top;labelPosition=center;align=center;spacingTop=-6;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="730.0" width="340" height="74" as="geometry"/></mxCell>
<mxCell id="nt2" value="&lt;b&gt;任务② 查SKU&lt;/b&gt;&lt;br&gt;QuerySkuVOFromDBThreadTask&lt;br&gt;goodsId → sku&lt;br&gt;得到 originalPrice 原价" style="rounded=1;whiteSpace=wrap;html=1;shape=cylinder3;boundedLbl=1;backgroundOutline=1;verticalAlign=top;labelPosition=center;align=center;spacingTop=-6;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1320.0" y="730.0" width="340" height="74" as="geometry"/></mxCell>
<mxCell id="ntm" value="&lt;b&gt;任一查询超时 5s&lt;/b&gt;&lt;br&gt;抛 TimeoutException → 试算失败&lt;br&gt;⚠ FutureTask 无法中途取消，慢查询仍占线程" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#a61b1b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890.0" y="905.0" width="330" height="74" as="geometry"/></mxCell>
<mxCell id="nmk2" value="&lt;b&gt;MarketNode.doApply · 选策略算价&lt;/b&gt;&lt;br&gt;markPlan = 活动配置的营销计划码&lt;br&gt;discountCalculateServiceMap.get(markPlan)&lt;br&gt;(Spring 把 4 个折扣 Bean 按名字注入成 Map)&lt;br&gt;取不到 → 抛 E0001" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890.0" y="1080.0" width="340" height="64" as="geometry"/></mxCell>
<mxCell id="nzk" value="&lt;b&gt;ZK · 折扣&lt;/b&gt;&lt;br&gt;应付 = 原价 × 0.8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30.0" y="1255.0" width="340" height="64" as="geometry"/></mxCell>
<mxCell id="nzj" value="&lt;b&gt;ZJ · 直减&lt;/b&gt;&lt;br&gt;应付 = 原价 − X" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="1255.0" width="340" height="64" as="geometry"/></mxCell>
<mxCell id="nmj" value="&lt;b&gt;MJ · 满减&lt;/b&gt;&lt;br&gt;满 X 减 Y（表达式X,Y）&lt;br&gt;原价&lt;X 则不参与" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890.0" y="1255.0" width="340" height="64" as="geometry"/></mxCell>
<mxCell id="nn" value="&lt;b&gt;N · N元购&lt;/b&gt;&lt;br&gt;应付 = 固定 N 元" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1320.0" y="1255.0" width="340" height="64" as="geometry"/></mxCell>
<mxCell id="np" value="&lt;b&gt;模板方法 calculate() 统一前置&lt;/b&gt;&lt;br&gt;折扣类型=TAG 时先做人群过滤：&lt;br&gt;不在人群 → 直接返回原价(不给优惠)&lt;br&gt;doCalculate 由子类实现&lt;br&gt;ensureMinimumPrice 兜底最低 0.01，防倒贴钱" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f6000;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="460.0" y="1430.0" width="420" height="150" as="geometry"/></mxCell>
<mxCell id="npay" value="&lt;b&gt;把结果写回共享上下文&lt;/b&gt;&lt;br&gt;deductionPrice = 原价 − 应付价&lt;br&gt;payPrice = 应付价" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890.0" y="1605.0" width="340" height="64" as="geometry"/></mxCell>
<mxCell id="nroute" value="&lt;b&gt;get() 决定下一节点&lt;/b&gt;&lt;br&gt;activityVO/skuVO/deductionPrice 任一为空&lt;br&gt;→ ErrorNode(抛 E0002 无拼团营销配置)" style="rounded=1;whiteSpace=wrap;html=1;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890.0" y="1780.0" width="310" height="106" as="geometry"/></mxCell>
<mxCell id="nerr" value="&lt;b&gt;ErrorNode · 无营销配置&lt;/b&gt;&lt;br&gt;抛 E0002 或返回空" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#a61b1b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890.0" y="1955.0" width="330" height="74" as="geometry"/></mxCell>
<mxCell id="ntag" value="&lt;b&gt;TagNode · 人群标签过滤&lt;/b&gt;&lt;br&gt;活动带 tagId ?&lt;br&gt;repository.isTagCrowRange(tagId,userId)&lt;br&gt;(底层 Redis RBitSet 判断，见 4.6 图)&lt;br&gt;命中 → visible=可参与；未配标签 → 默认放行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890.0" y="2130.0" width="340" height="64" as="geometry"/></mxCell>
<mxCell id="nend" value="&lt;b&gt;EndNode · 组装返回&lt;/b&gt;&lt;br&gt;TrialBalanceEntity&lt;br&gt;{ 原价, 立减, 应付, target 拼团人数,&lt;br&gt;活动起止时间, visible/enable, 活动+折扣VO }&lt;br&gt;→ Controller 再拼&quot;进行中的团/团队热度&quot;给页面" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="890.0" y="2305.0" width="260" height="56" as="geometry"/></mxCell>
<mxCell id="nt1n" value="&lt;b&gt;新增营销玩法 = 只加一个类&lt;/b&gt;&lt;br&gt;新建 @Service(&quot;XX&quot;) 继承 AbstractDiscountCalculateService&lt;br&gt;实现 doCalculate() 即可，MarketNode 一行不改&lt;br&gt;——策略模式 + Spring Map 注册表，开闭原则" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f6000;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="1605.0" width="400" height="110" as="geometry"/></mxCell>
<mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="nstart" target="nroot"><mxGeometry relative="1" as="geometry"/></mxCell>
