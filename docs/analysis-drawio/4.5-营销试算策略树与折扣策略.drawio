<mxCell id="e16" value="缺数据" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#b85450;fontColor=#b85450;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="nroute" target="nerr"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e17" value="数据齐" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="nroute" target="ntag"><mxGeometry relative="1" as="geometry"/></mxCell>
