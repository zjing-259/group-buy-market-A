<mxfile host="app.diagrams.net" agent="generator" version="24.0.0">
  <diagram id="4.2-成团判定与可靠结算" name="4.2-成团判定与可靠结算">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="2600" math="0" shadow="0">
      <root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="nstart" value="&lt;b&gt;支付成功回调进入&lt;/b&gt;&lt;br&gt;settlementMarketPayOrder(&lt;br&gt;TradePaySuccessEntity: userId/outTradeNo/outTradeTime)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="30.0" width="220" height="48" as="geometry"/></mxCell>
<mxCell id="nc1" value="&lt;b&gt;① 结算规则链过滤（先读团快照）&lt;/b&gt;&lt;br&gt;SC黑名单 → E0105&lt;br&gt;单存在(未支付) → E0104&lt;br&gt;支付时间在团有效期内 → E0106&lt;br&gt;EndRule 读出团快照: targetCount/completeCount/&lt;br&gt;lockCount/validEndTime/notifyUrl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="205.0" width="340" height="64" as="geometry"/></mxCell>
<mxCell id="nc1no" value="&lt;b&gt;规则不过 → 直接拒绝&lt;/b&gt;&lt;br&gt;E0104/E0105/E0106 任一抛出，结算结束" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#a61b1b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1320.0" y="205.0" width="330" height="74" as="geometry"/></mxCell>
<mxCell id="ntx" value="&lt;b&gt;事务开始（同一 @Transactional(timeout=500)）&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="380.0" width="340" height="64" as="geometry"/></mxCell>
<mxCell id="ns1" value="&lt;b&gt;② 个人明细支付&lt;/b&gt;&lt;br&gt;UPDATE group_buy_order_list&lt;br&gt;SET status=1(已支付), out_trade_time=?&lt;br&gt;WHERE out_trade_no=? AND user_id=?&lt;br&gt;行数≠1 → 抛 UPDATE_ZERO" style="rounded=1;whiteSpace=wrap;html=1;shape=cylinder3;boundedLbl=1;backgroundOutline=1;verticalAlign=top;labelPosition=center;align=center;spacingTop=-6;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="555.0" width="340" height="74" as="geometry"/></mxCell>
<mxCell id="ns2" value="&lt;b&gt;③ 团达成人数 +1（带守卫）&lt;/b&gt;&lt;br&gt;UPDATE group_buy_order&lt;br&gt;SET complete_count = complete_count + 1&lt;br&gt;WHERE team_id=?&lt;br&gt;  AND complete_count &lt; target_count&lt;br&gt;(防&quot;已成团还继续结算进来&quot;)" style="rounded=1;whiteSpace=wrap;html=1;shape=cylinder3;boundedLbl=1;backgroundOutline=1;verticalAlign=top;labelPosition=center;align=center;spacingTop=-6;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="730.0" width="340" height="74" as="geometry"/></mxCell>
<mxCell id="ndec1" value="&lt;b&gt;这一单是&quot;最后一员&quot;吗 ?
判断：targetCount - 1 == completeCount
(completeCount 是①步的快照值)&lt;/b&gt;&lt;br&gt;⚠ 用的是事务开始前的快照，不是+1后的值" style="rounded=1;whiteSpace=wrap;html=1;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="905.0" width="310" height="106" as="geometry"/></mxCell>
<mxCell id="nnotfull" value="&lt;b&gt;团未满员&lt;/b&gt;&lt;br&gt;return false —— 团继续拼单中&lt;br&gt;等待下一位支付，成团后再通知" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="1080.0" width="260" height="56" as="geometry"/></mxCell>
<mxCell id="ns3" value="&lt;b&gt;④ 团置为完成（防重）&lt;/b&gt;&lt;br&gt;UPDATE group_buy_order&lt;br&gt;SET status=1 WHERE team_id=? AND status=0" style="rounded=1;whiteSpace=wrap;html=1;shape=cylinder3;boundedLbl=1;backgroundOutline=1;verticalAlign=top;labelPosition=center;align=center;spacingTop=-6;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1320.0" y="1080.0" width="340" height="74" as="geometry"/></mxCell>
<mxCell id="ns4" value="&lt;b&gt;⑤ 收集该团全部已支付外部单号&lt;/b&gt;&lt;br&gt;SELECT out_trade_no&lt;br&gt;FROM group_buy_order_list&lt;br&gt;WHERE team_id=? AND status=1" style="rounded=1;whiteSpace=wrap;html=1;shape=cylinder3;boundedLbl=1;backgroundOutline=1;verticalAlign=top;labelPosition=center;align=center;spacingTop=-6;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1320.0" y="1255.0" width="340" height="74" as="geometry"/></mxCell>
<mxCell id="ns5" value="&lt;b&gt;⑥ 同事务写入回调任务&lt;/b&gt;&lt;br&gt;INSERT notify_task&lt;br&gt;(notify_status=0, notify_count=0,&lt;br&gt;parameterJson = {teamId, outTradeNoList})&lt;br&gt;→ 团&quot;完成&quot;与&quot;待通知任务&quot;要么一起成功要么一起回滚" style="rounded=1;whiteSpace=wrap;html=1;shape=cylinder3;boundedLbl=1;backgroundOutline=1;verticalAlign=top;labelPosition=center;align=center;spacingTop=-6;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1320.0" y="1430.0" width="340" height="74" as="geometry"/></mxCell>
<mxCell id="nok1" value="&lt;b&gt;✓ 成团完成，return true&lt;/b&gt;&lt;br&gt;立刻 execSettlementNotifyJob(teamId)&lt;br&gt;触发一次回调投递（见 4.3 图）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1320.0" y="1605.0" width="260" height="56" as="geometry"/></mxCell>
<mxCell id="nw1" value="&lt;b&gt;⚠ 并发窗口：快照判定会丢成团&lt;/b&gt;&lt;br&gt;设想团 target=3、快照 completeCount=1，&lt;br&gt;两个用户&quot;同时&quot;支付结算：&lt;br&gt;· 两笔都先通过 complete_count&lt;target_count 守卫 → 计数被推到 3&lt;br&gt;· 但两笔都用快照判 1 == target-1(2)? → 都不成立&lt;br&gt;→ 团已满员却永远停在&quot;拼单中&quot;，notify_task 永不写入，回调丢失！&lt;br&gt;&lt;br&gt;修复：不要拿事务前快照判 == target-1，应在递增&quot;之后&quot;看 complete_count 是否到达 target，&lt;br&gt;例如 SQL 里 status = IF(complete_count+1&gt;=target_count,1,status) 一步完成。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#a61b1b;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="555.0" width="400" height="210" as="geometry"/></mxCell>
<mxCell id="nw2" value="&lt;b&gt;⚠ 明细更新缺 status 过滤&lt;/b&gt;&lt;br&gt;②步 UPDATE ... WHERE out_trade_no AND user_id&lt;br&gt;没有带 status=0，也没有支付事件幂等键&lt;br&gt;→ 同一 outTradeNo 被重复回调结算时会重复 +1、&lt;br&gt;可能把一个付款人算两次数（可用支付事件唯一ID + status条件解决）。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#a61b1b;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="1430.0" width="400" height="150" as="geometry"/></mxCell>
<mxCell id="nt1" value="&lt;b&gt;结论一句话&lt;/b&gt;&lt;br&gt;难点在&quot;最后一单&quot;判定必须可靠且并发安全；&lt;br&gt;任务写入与团状态同事务保证&quot;完成必通知&quot;。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f6000;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="1780.0" width="400" height="100" as="geometry"/></mxCell>
<mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="nstart" target="nc1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e1" value="不过" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#b85450;fontColor=#b85450;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;" edge="1" parent="1" source="nc1" target="nc1no"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="通过" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="nc1" target="ntx"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="ntx" target="ns1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="ns1" target="ns2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="ns2" target="ndec1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e6" value="否 · 没满" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="ndec1" target="nnotfull"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e7" value="是 · 最后一单" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#9673a6;fontColor=#9673a6;exitX=1.0;exitY=0.5;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="ndec1" target="ns3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="ns3" target="ns4"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="ns4" target="ns5"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="ns5" target="nok1"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
