<mxfile host="app.diagrams.net" agent="generator" version="24.0.0">
  <diagram id="4.3-无MQ的可靠通知" name="4.3-无MQ的可靠通知">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="2600" math="0" shadow="0">
      <root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="nstart" value="&lt;b&gt;两个投递入口&lt;/b&gt;&lt;br&gt;A. 结算成团 → 立即 execSettlementNotifyJob(teamId)&lt;br&gt;B. 定时兜底 GroupBuyNotifyJob：cron 0/15 * * * * ?&lt;br&gt;   扫 notify_status IN (0,2) LIMIT 50" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="30.0" width="220" height="48" as="geometry"/></mxCell>
<mxCell id="nq1" value="&lt;b&gt;取出待投递任务&lt;/b&gt;&lt;br&gt;notify_task: teamId/notifyUrl/&lt;br&gt;notifyCount/notifyStatus/parameterJson" style="rounded=1;whiteSpace=wrap;html=1;shape=cylinder3;boundedLbl=1;backgroundOutline=1;verticalAlign=top;labelPosition=center;align=center;spacingTop=-6;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="205.0" width="340" height="74" as="geometry"/></mxCell>
<mxCell id="nlock" value="&lt;b&gt;① 每团一把分布式锁抢占&lt;/b&gt;&lt;br&gt;RLock key = notify_job_lock_key_{teamId}&lt;br&gt;tryLock(3, 0, SECONDS)&lt;br&gt;(Redisson，多实例防重复投递)" style="rounded=1;whiteSpace=wrap;html=1;shape=cylinder3;boundedLbl=1;backgroundOutline=1;verticalAlign=top;labelPosition=center;align=center;spacingTop=-6;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="380.0" width="300" height="74" as="geometry"/></mxCell>
<mxCell id="ndec1" value="&lt;b&gt;抢到锁 ?&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="555.0" width="310" height="106" as="geometry"/></mxCell>
<mxCell id="nnull0" value="&lt;b&gt;本次&quot;空执行&quot;，不改状态&lt;/b&gt;&lt;br&gt;返回 NULL —— 别的实例正在发&lt;br&gt;任务保持原状态，等下一轮 15s 再扫" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#a61b1b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1320.0" y="555.0" width="330" height="74" as="geometry"/></mxCell>
<mxCell id="nsend" value="&lt;b&gt;② 发出成团回调&lt;/b&gt;&lt;br&gt;gateway GroupBuyNotifyService&lt;br&gt;OkHttp 同步 POST notifyUrl&lt;br&gt;body = parameterJson(teamId + outTradeNoList)&lt;br&gt;(第三方可用 TestApiClientController 模拟收方)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="730.0" width="300" height="64" as="geometry"/></mxCell>
<mxCell id="ndec2" value="&lt;b&gt;回调方返回什么 ?&lt;/b&gt;&lt;br&gt;success / error / (超时·异常 → 视作 null)" style="rounded=1;whiteSpace=wrap;html=1;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="905.0" width="310" height="106" as="geometry"/></mxCell>
<mxCell id="nsucc" value="&lt;b&gt;success → 标记成功&lt;/b&gt;&lt;br&gt;UPDATE notify_task&lt;br&gt;SET notify_status=1, notify_count+1" style="rounded=1;whiteSpace=wrap;html=1;shape=cylinder3;boundedLbl=1;backgroundOutline=1;verticalAlign=top;labelPosition=center;align=center;spacingTop=-6;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="1080.0" width="340" height="74" as="geometry"/></mxCell>
<mxCell id="nsuccE" value="&lt;b&gt;✓ 任务终态(成功)，投递闭环完成&lt;/b&gt;&lt;br&gt;后续不再被任何 Job 扫描" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="1255.0" width="260" height="56" as="geometry"/></mxCell>
<mxCell id="ndec3" value="&lt;b&gt;失败了几次 ?
(notifyCount &lt; 5 ?)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1320.0" y="1080.0" width="310" height="106" as="geometry"/></mxCell>
<mxCell id="nerr" value="&lt;b&gt;未超 5 次 → 记&quot;失败&quot;&lt;/b&gt;&lt;br&gt;UPDATE notify_task&lt;br&gt;SET notify_status=3, notify_count+1" style="rounded=1;whiteSpace=wrap;html=1;shape=cylinder3;boundedLbl=1;backgroundOutline=1;verticalAlign=top;labelPosition=center;align=center;spacingTop=-6;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1320.0" y="1255.0" width="340" height="74" as="geometry"/></mxCell>
<mxCell id="nerrE" value="&lt;b&gt;状态3 = 不再被扫描&lt;/b&gt;&lt;br&gt;⚠ Job 只扫 IN(0,2)，扫不到 3&lt;br&gt;→ 实际只给了极少数几次机会" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#a61b1b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1320.0" y="1430.0" width="330" height="74" as="geometry"/></mxCell>
<mxCell id="nretry" value="&lt;b&gt;超 5 次 → 记&quot;重试&quot;&lt;/b&gt;&lt;br&gt;UPDATE notify_task&lt;br&gt;SET notify_status=2, notify_count+1" style="rounded=1;whiteSpace=wrap;html=1;shape=cylinder3;boundedLbl=1;backgroundOutline=1;verticalAlign=top;labelPosition=center;align=center;spacingTop=-6;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="1430.0" width="340" height="74" as="geometry"/></mxCell>
<mxCell id="nretryE" value="&lt;b&gt;状态2 = 被扫描 → 无限重试&lt;/b&gt;&lt;br&gt;回到顶部入口 B，每 15s 再次投递" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#a61b1b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="1605.0" width="330" height="74" as="geometry"/></mxCell>
<mxCell id="nw1" value="&lt;b&gt;⚠ 状态机方向疑似写反&lt;/b&gt;&lt;br&gt;观察上面两条：&lt;br&gt;· 失败次数 &lt;5 的任务 → 置成 3 → 反而&quot;不再被补偿扫描&quot;(像放弃了)&lt;br&gt;· 失败次数 ≥5 的任务 → 置成 2 → 反而&quot;无限重试&quot;&lt;br&gt;与常规&quot;失败N次后放弃/告警&quot;的语义正好相反。&lt;br&gt;疑为教学代码笔误/命名歧义，真实系统需澄清：&lt;br&gt;3 该不该进扫描？要不要发告警？" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#a61b1b;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="555.0" width="400" height="170" as="geometry"/></mxCell>
<mxCell id="nt1" value="&lt;b&gt;状态机转移图&lt;/b&gt;&lt;br&gt;0待处理 ──成团/补偿扫描──► 投递中&lt;br&gt;投递中 ──&quot;success&quot;──► 1成功(终态)&lt;br&gt;投递中 ──&quot;error&quot;且&lt;5次──► 3失败(不再扫，疑似笔误)&lt;br&gt;投递中 ──&quot;error&quot;且≥5次──► 2重试(被扫，疑似笔误)&lt;br&gt;投递中 ──null(没抢锁/异常)──► 不改状态(等15s再试)&lt;br&gt;2 ──Job扫描──► 重新回到&quot;投递中&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f6000;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="1955.0" width="400" height="190" as="geometry"/></mxCell>
<mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="nstart" target="nq1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="nq1" target="nlock"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="nlock" target="ndec1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="否 · 没抢到" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#b85450;fontColor=#b85450;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;" edge="1" parent="1" source="ndec1" target="nnull0"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="是 · 抢到锁" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="ndec1" target="nsend"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="nsend" target="ndec2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e6" value="&quot;success&quot;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#82b366;fontColor=#82b366;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="ndec2" target="nsucc"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="nsucc" target="nsuccE"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e8" value="&quot;error&quot;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#b85450;fontColor=#b85450;exitX=1.0;exitY=0.5;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="ndec2" target="ndec3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e9" value="是 · &lt;5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#b85450;fontColor=#b85450;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="ndec3" target="nerr"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#b85450;fontColor=#b85450;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="nerr" target="nerrE"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e11" value="否 · ≥5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#b85450;fontColor=#b85450;exitX=0.0;exitY=0.5;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="ndec3" target="nretry"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#b85450;fontColor=#b85450;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="nretry" target="nretryE"><mxGeometry relative="1" as="geometry"/></mxCell>
