<mxfile host="app.diagrams.net" agent="generator" version="24.0.0">
  <diagram id="4.1-拼团锁单并发控制" name="4.1-拼团锁单并发控制">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="2600" math="0" shadow="0">
      <root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="nstart" value="&lt;b&gt;参团请求进入&lt;/b&gt;&lt;br&gt;lockMarketPayOrder(userId, goodsId,&lt;br&gt;activityId, teamId?, outTradeNo, notifyUrl)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="30.0" width="220" height="48" as="geometry"/></mxCell>
<mxCell id="nc1" value="&lt;b&gt;① 交易规则链先做三道校验&lt;/b&gt;&lt;br&gt;活动状态=生效 ?  时间窗内 ?&lt;br&gt;已参团次数 &lt; takeLimitCount ?&lt;br&gt;(任一不过 → 抛 E0101/E0102/E0103)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="205.0" width="340" height="64" as="geometry"/></mxCell>
<mxCell id="nc1no" value="&lt;b&gt;规则不通过 → 拦截&lt;/b&gt;&lt;br&gt;E0101 活动未生效 / E0102 活动已失效 /&lt;br&gt;E0103 已达限购次数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#a61b1b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1320.0" y="205.0" width="330" height="74" as="geometry"/></mxCell>
<mxCell id="nr1" value="&lt;b&gt;② 返回已参团次数&lt;/b&gt;&lt;br&gt;userTakeOrderCount（用于拼幂等 bizId）&lt;br&gt;同时可判定用户是&quot;发起&quot;还是&quot;加入&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="380.0" width="340" height="64" as="geometry"/></mxCell>
<mxCell id="ndec1" value="&lt;b&gt;是否携带 teamId 加入已有团 ?&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="555.0" width="310" height="106" as="geometry"/></mxCell>
<mxCell id="nopen0" value="&lt;b&gt;开新团：初始化团记录&lt;/b&gt;&lt;br&gt;teamId = 随机8位数字&lt;br&gt;INSERT group_buy_order&lt;br&gt;lock_count=1  complete_count=0&lt;br&gt;status=0  target_count=活动人数&lt;br&gt;validEndTime = now + validTime(分钟)" style="rounded=1;whiteSpace=wrap;html=1;shape=cylinder3;boundedLbl=1;backgroundOutline=1;verticalAlign=top;labelPosition=center;align=center;spacingTop=-6;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1750.0" y="730.0" width="340" height="74" as="geometry"/></mxCell>
<mxCell id="njoin0" value="&lt;b&gt;参团：原子&quot;先到先得&quot;占位&lt;/b&gt;&lt;br&gt;UPDATE group_buy_order&lt;br&gt;SET lock_count = lock_count + 1&lt;br&gt;WHERE team_id = ?&lt;br&gt;  AND lock_count &lt; target_count&lt;br&gt;(自带防超员条件，行级加锁串行化并发)" style="rounded=1;whiteSpace=wrap;html=1;shape=cylinder3;boundedLbl=1;backgroundOutline=1;verticalAlign=top;labelPosition=center;align=center;spacingTop=-6;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="730.0" width="340" height="74" as="geometry"/></mxCell>
<mxCell id="ndec2" value="&lt;b&gt;UPDATE 影响行数 == 1 ?&lt;/b&gt;&lt;br&gt;行数≠1 → 说明团已满或团不存在" style="rounded=1;whiteSpace=wrap;html=1;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="905.0" width="310" height="106" as="geometry"/></mxCell>
<mxCell id="nfull" value="&lt;b&gt;抛 E0005 拼团组队失败&lt;/b&gt;&lt;br&gt;lock_count 已达 target_count，进不去了&lt;br&gt;（条件更新原子地挡掉了并发超卖）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#a61b1b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1320.0" y="905.0" width="330" height="74" as="geometry"/></mxCell>
<mxCell id="nr2" value="&lt;b&gt;③ 写用户参团明细&lt;/b&gt;&lt;br&gt;orderId = 随机12位&lt;br&gt;INSERT group_buy_order_list&lt;br&gt;(userId, teamId, orderId, goodsId, ...)&lt;br&gt;bizId = activityId_userId_(已参次数+1)&lt;br&gt;status=0(CREATE)  outTradeNo 落库&lt;br&gt;→ 依赖 biz_id 唯一索引兜底幂等" style="rounded=1;whiteSpace=wrap;html=1;shape=cylinder3;boundedLbl=1;backgroundOutline=1;verticalAlign=top;labelPosition=center;align=center;spacingTop=-6;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="1080.0" width="340" height="74" as="geometry"/></mxCell>
<mxCell id="ndec3" value="&lt;b&gt;插入撞了唯一键 ?&lt;/b&gt;&lt;br&gt;DuplicateKeyException 由框架抛出" style="rounded=1;whiteSpace=wrap;html=1;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="1255.0" width="310" height="106" as="geometry"/></mxCell>
<mxCell id="ndup" value="&lt;b&gt;抛 INDEX_EXCEPTION(&quot;0003&quot;)&lt;/b&gt;&lt;br&gt;同一用户同一活动重复锁单&lt;br&gt;（规则链的&quot;统计次数&quot;并非原子，&lt;br&gt;并发窗口靠唯一索引兜住）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#a61b1b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1320.0" y="1255.0" width="330" height="74" as="geometry"/></mxCell>
<mxCell id="nok" value="&lt;b&gt;✓ 锁单成功&lt;/b&gt;&lt;br&gt;返回 MarketPayOrderEntity&lt;br&gt;{ orderId, deductionPrice, status=CREATE }&lt;br&gt;整个流程包在 @Transactional(timeout=500)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="1430.0" width="260" height="56" as="geometry"/></mxCell>
<mxCell id="nw1" value="&lt;b&gt;⚠ 坑1：占位无人释放&lt;/b&gt;&lt;br&gt;mapper 已写 updateSubtractionLockCount&lt;br&gt;(lock_count-1 WHERE lock_count&gt;0)，但主流程没有任何调用者&lt;br&gt;→ validEndTime 到了团没付齐，名额一直被占用、无解散回收闭环。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#a61b1b;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="380.0" width="400" height="150" as="geometry"/></mxCell>
<mxCell id="nw2" value="&lt;b&gt;⚠ 坑2 / 💡 要点&lt;/b&gt;&lt;br&gt;· 用 DB 条件更新 + 唯一索引，不引 Redis 锁 →&lt;br&gt;  没有&quot;锁在Redis、数据在MySQL&quot;的撕裂问题；&lt;br&gt;· 行锁粒度的代价：只适用单库/单团热行，&lt;br&gt;  吞吐极高时锁竞争会放大，再往上要分片或队列化。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#a61b1b;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="1080.0" width="400" height="150" as="geometry"/></mxCell>
<mxCell id="nt1" value="&lt;b&gt;结论一句话&lt;/b&gt;&lt;br&gt;参团防超卖 = WHERE lock_count&lt;target_count 的条件更新；&lt;br&gt;防重复 = biz_id 唯一索引；二者都在事务里原子完成。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f6000;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="1605.0" width="400" height="100" as="geometry"/></mxCell>
<mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="nstart" target="nc1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e1" value="不通过" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#b85450;fontColor=#b85450;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;" edge="1" parent="1" source="nc1" target="nc1no"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="通过" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="nc1" target="nr1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="nr1" target="ndec1"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e4" value="否 · 未带 teamId" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#9673a6;fontColor=#9673a6;exitX=1.0;exitY=0.5;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="ndec1" target="nopen0"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e5" value="是 · 带 teamId 参团" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#9673a6;fontColor=#9673a6;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="ndec1" target="njoin0"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="njoin0" target="ndec2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e7" value="否 (0 行)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#b85450;fontColor=#b85450;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;" edge="1" parent="1" source="ndec2" target="nfull"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1.0;entryX=1.0;entryY=0.5;" edge="1" parent="1" source="nopen0" target="nr2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e9" value="是 (1 行)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="ndec2" target="nr2"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="nr2" target="ndec3"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e11" value="是 · 幂等拦截" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#b85450;fontColor=#b85450;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;" edge="1" parent="1" source="ndec3" target="ndup"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e12" value="否 · 正常插入" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="ndec3" target="nok"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
