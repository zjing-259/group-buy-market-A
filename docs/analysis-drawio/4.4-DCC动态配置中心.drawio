<mxfile host="app.diagrams.net" agent="generator" version="24.0.0">
  <diagram id="4.4-DCC动态配置中心" name="4.4-DCC动态配置中心">
    <mxGraphModel dx="1100" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="2600" math="0" shadow="0">
      <root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="nf1" value="&lt;b&gt;┌─ 上半：应用启动时的自动装配 ───────────┐&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=13;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30.0" y="30.0" width="640" height="58" as="geometry"/></mxCell>
<mxCell id="nf2" value="&lt;b&gt;└─ 下半：运行期的热更新下发 ─────────────┘&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;fontColor=#666666;fontSize=13;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="30.0" y="1080.0" width="640" height="58" as="geometry"/></mxCell>
<mxCell id="nboot" value="&lt;b&gt;Spring 启动，各 Bean 实例化&lt;/b&gt;&lt;br&gt;DCCService 是 @Service，字段上打 @DCCValue&lt;br&gt;@DCCValue(&quot;downgradeSwitch:0&quot;)&lt;br&gt;@DCCValue(&quot;cutRange:100&quot;)&lt;br&gt;@DCCValue(&quot;scBlacklist:s02c02&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="205.0" width="220" height="48" as="geometry"/></mxCell>
<mxCell id="nbpp" value="&lt;b&gt;BeanPostProcessor 逐字段扫描&lt;/b&gt;&lt;br&gt;postProcessAfterInitialization()&lt;br&gt;对每个 bean 反射遍历字段&lt;br&gt;(若是 AOP 代理先 getTargetClass 穿透)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="380.0" width="340" height="64" as="geometry"/></mxCell>
<mxCell id="ndec" value="&lt;b&gt;字段上有 @DCCValue(&quot;key:默认值&quot;) ?&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;shape=rhombus;perimeter=rhombusPerimeter;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="555.0" width="310" height="106" as="geometry"/></mxCell>
<mxCell id="nskip" value="&lt;b&gt;不是 → 跳过&lt;/b&gt;&lt;br&gt;继续扫下一个 bean" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#a61b1b;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="730.0" width="330" height="74" as="geometry"/></mxCell>
<mxCell id="nrb" value="&lt;b&gt;读取/初始化 Redis 键&lt;/b&gt;&lt;br&gt;RBucket = group_buy_market_dcc_{key}&lt;br&gt;不存在 → 写入注解默认值&lt;br&gt;存在 → 采用 Redis 里的现值&lt;br&gt;(保证重启后恢复线上值而非默认值)" style="rounded=1;whiteSpace=wrap;html=1;shape=cylinder3;boundedLbl=1;backgroundOutline=1;verticalAlign=top;labelPosition=center;align=center;spacingTop=-6;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1320.0" y="730.0" width="300" height="74" as="geometry"/></mxCell>
<mxCell id="ninj" value="&lt;b&gt;反射注入字段值&lt;/b&gt;&lt;br&gt;field.set(bean, 现值)&lt;br&gt;并把该 bean 注册进 dccObject 表&lt;br&gt;(key = Redis键 → bean 实例)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1320.0" y="905.0" width="340" height="64" as="geometry"/></mxCell>
<mxCell id="nsub" value="&lt;b&gt;注册运行时监听&lt;/b&gt;&lt;br&gt;@Bean dccTopic&lt;br&gt;订阅频道 group_buy_market_dcc" style="rounded=1;whiteSpace=wrap;html=1;shape=cylinder3;boundedLbl=1;backgroundOutline=1;verticalAlign=top;labelPosition=center;align=center;spacingTop=-6;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1320.0" y="1080.0" width="300" height="74" as="geometry"/></mxCell>
<mxCell id="nops" value="&lt;b&gt;运营/运维发起修改&lt;/b&gt;&lt;br&gt;curl GET  /api/v1/gbm/dcc/update_config&lt;br&gt;?key=cutRange&amp;value=0  (DCCController)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="1255.0" width="300" height="64" as="geometry"/></mxCell>
<mxCell id="npub" value="&lt;b&gt;publish &quot;cutRange,0&quot;&lt;/b&gt;&lt;br&gt;向频道 group_buy_market_dcc 发一条消息" style="rounded=1;whiteSpace=wrap;html=1;shape=cylinder3;boundedLbl=1;backgroundOutline=1;verticalAlign=top;labelPosition=center;align=center;spacingTop=-6;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="1430.0" width="300" height="74" as="geometry"/></mxCell>
<mxCell id="nlis" value="&lt;b&gt;监听器收到 → 校验并写新值&lt;/b&gt;&lt;br&gt;bucket 不存在则忽略&lt;br&gt;存在 → RBucket.set(新值)&lt;br&gt;→ 从 dccObject 找到 DCCService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="1605.0" width="340" height="64" as="geometry"/></mxCell>
<mxCell id="nsetf" value="&lt;b&gt;反射热更字段&lt;/b&gt;&lt;br&gt;DCCService.cutRange = &quot;0&quot;&lt;br&gt;秒级生效，全程无需重启应用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="1780.0" width="340" height="64" as="geometry"/></mxCell>
<mxCell id="nuse" value="&lt;b&gt;三个消费点同时读到新值&lt;/b&gt;&lt;br&gt;① SwitchNode(试算入口)：&lt;br&gt;   downgradeSwitch=1 → 抛 E0003 整站降级&lt;br&gt;   cutRange: |hash(userId)|%100&lt;=cutRange 才放行，&lt;br&gt;   否则抛 E0004 切量拦截(灰度)&lt;br&gt;② SCRuleFilter(结算入口)：&lt;br&gt;   scBlacklist 含 source+channel → 抛 E0105&lt;br&gt;③ TradeRepository.isSCBlackIntercept 委托 DCCService" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1e1e1e;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460.0" y="1955.0" width="340" height="64" as="geometry"/></mxCell>
<mxCell id="nw1" value="&lt;b&gt;⚠ 取舍&lt;/b&gt;&lt;br&gt;教学轻量方案替代 Nacos/Apollo：&lt;br&gt;· 无配置审计/回滚/灰度发布；&lt;br&gt;· 反射注入无类型与版本校验；&lt;br&gt;· 多语言/多副本一致性靠 Redis 单键。&lt;br&gt;但&quot;注解 + BeanPostProcessor + Pub/Sub + 反射&quot;&lt;br&gt;本身就是配置中心 SDK 的缩小版，思路可迁移。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#a61b1b;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="555.0" width="400" height="160" as="geometry"/></mxCell>
<mxCell id="nt1" value="&lt;b&gt;一句话&lt;/b&gt;&lt;br&gt;运营想&quot;不改代码关活动/切量/拉黑&quot;，&lt;br&gt;靠一张 Redis 键 + 一个 Pub/Sub 频道 + 反射热更解决。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7f6000;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="30.0" y="2130.0" width="400" height="90" as="geometry"/></mxCell>
<mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="nboot" target="nbpp"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="nbpp" target="ndec"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e2" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0.5;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="ndec" target="nskip"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="e3" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#d79b00;fontColor=#d79b00;exitX=1.0;exitY=0.5;entryX=0.5;entryY=0.0;" edge="1" parent="1" source="ndec" target="nrb"><mxGeometry relative="1" as="geometry"/></mxCell>
